#!/usr/bin/env bash
# main / develop への直接コミットを禁止する（CLAUDE.md「Git 運用」）。
# 取り込みは GitHub の PR マージだけで行う。
set -euo pipefail

branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"

case "$branch" in
  main|develop)
    echo "error: '$branch' への直接コミットは禁止です。作業ブランチ（feature/* など）を切って PR でマージしてください。" >&2
    exit 1
    ;;
esac
