# compose が読む値。cp .env.example .env してから必要なら書き換える。
# 未設定でも compose.yaml の既定値で動く。

# ホストに公開するポート（他のプロジェクトと衝突したら変える）。SERVER_PORT は Caddy（ロードバランサ）のポート
SERVER_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Postgres
POSTGRES_USER=hibari
POSTGRES_PASSWORD=hibari
POSTGRES_DB=hibari

# MinIO（ローカル専用の認証情報）
MINIO_ROOT_USER=hibari
MINIO_ROOT_PASSWORD=hibari-secret

# server（コンテナ内の値。DATABASE_URL / REDIS_URL は compose.yaml で組み立てる）
LOG_LEVEL=debug
LOG_FORMAT=text
SHUTDOWN_TIMEOUT=15s

# 認証（JWT_PRIVATE_KEY_FILE は compose.yaml で設定する）
JWT_ISSUER=hibari
JWT_AUDIENCE=hibari-api
REFRESH_COOKIE_SECURE=true
# Web クライアントの URL。メールのリンクの起点で、WebSocket の Origin と CORS で許可するオリジンにも使う（ADR 0021）。
# 開発では dev mailer がリンクを server のログに出す
APP_BASE_URL=http://localhost:3000
# X-Forwarded-For を信用する前段のプロキシ（CIDR）。compose では Caddy のアドレス（CADDY_IP）から compose.yaml が組み立てる。
# 空なら XFF を読まない。環境ごとの値は docs/deploy.md（ADR 0017）
# TRUSTED_PROXIES=

# compose のネットワーク。Caddy のアドレスを固定するためにサブネットを決めている。ほかのネットワークと衝突したら変える
# COMPOSE_SUBNET=172.31.250.0/24
# COMPOSE_IP_RANGE=172.31.250.128/25
# CADDY_IP=172.31.250.10

# 添付ファイル（S3_* は compose.yaml で MinIO に向けて設定する。ADR 0013）
# ATTACHMENT_MAX_BYTES=26214400
# ATTACHMENT_ALLOWED_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,application/octet-stream

# アバター画像（ADR 0020）。既定は 2 MiB と png / jpeg / webp。SVG は入れない。
# AVATAR_MAX_BYTES=2097152
# AVATAR_ALLOWED_TYPES=image/png,image/jpeg,image/webp
