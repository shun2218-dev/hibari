# cp .env.example .env.local（`make web` は .env.local がなければ自動でコピーする）
# compose の server が公開しているポート（ルートの .env の SERVER_PORT）に合わせる。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# og:image などの絶対 URL の起点（ADR 0063 決定 7）。本番は https://app.hibari-chat.com をビルドの環境に置く。
APP_BASE_URL=http://localhost:3000
# LP（apex）の絶対 URL の起点（ADR 0063 決定 5 / 7）。proxy.ts はこのホストで開かれたら LP を返す。
# ローカルは http://lp.localhost:3000 で LP を開く。本番は https://hibari-chat.com をビルドの環境に置く。
SITE_BASE_URL=http://lp.localhost:3000
